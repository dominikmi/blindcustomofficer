# Blind-spot: shaded + relocated fat jar — brotli4j classes are rewritten to
# hidden.vendor.*, dep META-INF stripped. Bytecode fingerprinting or nothing.
FROM maven:3.9-eclipse-temurin-21 AS build

WORKDIR /app
COPY src/pom.xml ./
COPY src/App.java ./src/main/java/shadedapp/App.java
RUN mvn -q -DskipTests package && \
    ls -l target/*.jar

FROM eclipse-temurin:21-jre

COPY --from=build /app/target/app-1.0.jar /opt/app/app.jar

CMD ["java", "-jar", "/opt/app/app.jar"]
