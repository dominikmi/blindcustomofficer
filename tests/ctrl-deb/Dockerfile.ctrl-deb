# Control: vulnerable brotli via dpkg — the package-manager path every scanner knows.
FROM debian:bookworm-slim

# Step 1: bootstrap TLS (slim has no ca-certificates) so snapshot.debian.org works.
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates; \
    rm -rf /var/lib/apt/lists/*

# Step 2: pin apt to the 2026-06-01 archive state (bookworm main only) —
# libbrotli1 resolves to the vulnerable 1.0.9-2+b1. The +deb12u1 fix
# did not exist at that date, and live bookworm-security stays out.
RUN set -eux; \
    rm -f /etc/apt/sources.list.d/*; \
    echo 'deb [check-valid-until=no] https://snapshot.debian.org/archive/debian/20260601T000000Z bookworm main' \
      > /etc/apt/sources.list; \
    apt-get update; \
    apt-get install -y --no-install-recommends libbrotli1; \
    rm -rf /var/lib/apt/lists/*; \
    dpkg -l libbrotli1

CMD ["dpkg", "-l", "libbrotli1"]
